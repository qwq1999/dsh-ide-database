{
  "name": "dsh-ide-database",
  "version": "0.2.0",
  "description": "JetBrains Database-style data source tool window and agent tools for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bridge/dsh-db-bridge.jar",
    "bridge/src",
    "jre",
    "assets",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "dsh": ">=0.1.6-alpha.2",
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:bridge && npm run build:host && npm run build:client",
    "build:bridge": "node scripts/build-bridge.mjs",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "pretest": "npm run build:host",
    "test:integration": "node scripts/integration-http.mjs",
    "qa:ui": "node scripts/qa-ui.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "changelog:check": "node scripts/build-changelog.mjs --check",
    "verify": "npm run typecheck && npm test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "database",
    "jdbc",
    "redis"
  ],
  "license": "MIT"
}
