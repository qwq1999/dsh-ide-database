{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "lib",
    "types": ["node"],
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src/index.ts",
    "src/host/**/*.ts",
    "src/shared/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["src/client"]
}
